# Top-level formal specifications.
# ProofPower HOL in SPaDE documents is fenced as hol inside markdown.
# This makefile strips those fences to .sml. Loading into ProofPower is separate.

MDWITHSML = tlcd001.md

include ../common/rules.mkf

.PHONY: all clean

all: $(SMLFROMMD)

clean:
	rm -f $(SMLFROMMD)
